# Each MCP user supplies credentials issued to their own Wanted OpenAPI account.
# Apply at: https://openapi.wanted.jobs/apply/
WANTED_CLIENT_ID=replace-with-your-client-id
WANTED_CLIENT_SECRET=replace-with-your-client-secret

# Required only for permission-gated or paid API capabilities assigned by Wanted.
# Preserve the value exactly as issued, including a scheme such as "Bearer" if any.
# WANTED_AUTHORIZATION=Bearer replace-with-your-token

# Optional. Production V2 is used by default.
# WANTED_API_BASE_URL=https://openapi.wanted.jobs/v2
# WANTED_REQUEST_TIMEOUT_MS=10000
